# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Thay thế <username>, <password>, <cluster-url> bằng thông tin từ MongoDB Atlas của bạn
# Ví dụ: mongodb+srv://admin:matkhau123@cluster0.abcde.mongodb.net/study-schedule-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/study-schedule-tracker?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_study_tracker_2026
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
